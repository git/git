"              [-u | -i]] [--index-output=<lêer>] [--no-sparse-checkout]\n"
"              (--empty | <boomagtige1> [<boomagtige2> [<boomagtige3>]])"

msgid "write resulting index to <file>"
msgstr "skryf resulterende indeks na <lêer>"

msgid "only empty the index"
msgstr "maak slegs die indeks leeg"

msgid "Merging"
msgstr "Saamsmelting"

msgid "perform a merge in addition to a read"
msgstr "voer 'n saamsmelting benewens 'n lees uit"

msgid "3-way merge if no file level merging required"
msgstr ""
"3-rigting-saamsmelting indien geen saamsmelting op lêervlak nodig is nie"

msgid "3-way merge in presence of adds and removes"
msgstr ""
"3-rigting-saamsmelting in die teenwoordigheid van byvoegings en verwyderings"

msgid "same as -m, but discard unmerged entries"
msgstr "dieselfde as -m, maar verwerp inskrywings wat nie saamgesmelt is nie"

msgid "<subdirectory>/"
msgstr "<subgids>/"

msgid "read the tree into the index under <subdirectory>/"
msgstr "lees die boom in die indeks onder <subgids>/ in"

msgid "update working tree with merge result"
msgstr "werk werkboom by met saamsmeltresultaat"

msgid "gitignore"
msgstr "gitignore"

msgid "allow explicitly ignored files to be overwritten"
msgstr "laat toe dat uitdruklik geïgnoreerde lêers oorskryf word"

msgid "don't check the working tree after merging"
msgstr "moenie die werkboom na saamsmelting nagaan nie"

msgid "don't update the index or the work tree"
msgstr "moenie die indeks of die werkboom bywerk nie"

msgid "skip applying sparse checkout filter"
msgstr "slaan die toepassing van die yl-uitcheck-filter oor"

msgid "debug unpack-trees"
msgstr "ontfout unpack-trees"

msgid "suppress feedback messages"
msgstr "onderdruk terugvoerboodskappe"

msgid "You need to resolve your current index first"
msgstr "Jy moet eers jou huidige indeks oplos"

