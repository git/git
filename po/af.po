#, c-format
msgid "Stage mode change%s [y,n,q,a,d%s,?]? "
msgstr "Plaas modusverandering%s [y,n,q,a,d%s,?]? "

#, c-format
msgid "Stage deletion%s [y,n,q,a,d%s,?]? "
msgstr "Plaas skrapping%s [y,n,q,a,d%s,?]? "

#, c-format
msgid "Stage addition%s [y,n,q,a,d%s,?]? "
msgstr "Plaas toevoeging%s [y,n,q,a,d%s,?]? "

#, c-format
msgid "Stage this hunk%s [y,n,q,a,d%s,?]? "
msgstr "Plaas hierdie brok%s [y,n,q,a,d%s,?]? "

msgid ""
"If the patch applies cleanly, the edited hunk will immediately be marked for "
"staging."
msgstr ""
"As die lap skoon toegepas word, sal die geredigeerde brok onmiddellik vir "
"plasing gemerk word."

msgid ""
"y - stage this hunk\n"
"n - do not stage this hunk\n"
"q - quit; do not stage this hunk or any of the remaining ones\n"
"a - stage this hunk and all later hunks in the file\n"
"d - do not stage this hunk or any of the later hunks in the file\n"
msgstr ""
"y - plaas hierdie brok\n"
"n - moenie hierdie brok plaas nie\n"
"q - verlaat; moenie hierdie brok of enige van die oorblywendes plaas nie\n"
"a - plaas hierdie brok en alle latere brokke in die lêer\n"
"d - moenie hierdie brok of enige van die latere brokke in die lêer plaas "
"nie\n"

#, c-format
