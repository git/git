msgstr ""
"git rebase [-i] [opsies] [--exec <opdrag>] [--onto <nuwebasis> | --keep-"
"base] [<stroomop> [<tak>]]"

msgid ""
"git rebase [-i] [options] [--exec <cmd>] [--onto <newbase>] --root [<branch>]"
msgstr ""
"git rebase [-i] [opsies] [--exec <opdrag>] [--onto <nuwebasis>] --root "
