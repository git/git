#, c-format
msgid "%s cannot be negative"
msgstr "%s não pode ser negativo"

#, c-format
msgid "could not parse hunk header '%.*s'"
msgstr "não foi possível analisar o cabeçalho do pedaço '%.*s'"

msgid "could not parse diff"
msgstr "não foi possível analisar o diff"

msgid "could not parse colored diff"
msgstr "não foi possível analisar o diff colorido"

#, c-format
msgid "failed to run '%s'"
msgstr "falha ao executar '%s'"

msgid "mismatched output from interactive.diffFilter"
msgstr "saída incompatível de interactive.diffFilter"

msgid ""
"Your filter must maintain a one-to-one correspondence\n"
"between its input and output lines."
msgstr ""
"Seu filtro deve manter uma correspondência um-para-um\n"
"entre suas linhas de entrada e saída."

#, c-format
msgid ""
"expected context line #%d in\n"
"%.*s"
msgstr ""
"linha de contexto esperada #%d em\n"
"%.*s"

#, c-format
msgid ""
"hunks do not overlap:\n"
"%.*s\n"
"\tdoes not end with:\n"
"%.*s"
msgstr ""
"pedaços não se sobrepõem:\n"
"%.*s\n"
"\tnão termina com:\n"
"%.*s"

msgid "Manual hunk edit mode -- see bottom for a quick guide.\n"
msgstr "Modo de edição manual de pedaços -- veja abaixo um guia rápido.\n"

#, c-format
msgid ""
"---\n"
"To remove '%c' lines, make them ' ' lines (context).\n"
"To remove '%c' lines, delete them.\n"
"Lines starting with %s will be removed.\n"
msgstr ""
"---\n"
"Para remover linhas '%c', transforme-as em linhas ' ' (contexto).\n"
"Para remover linhas '%c', exclua-as.\n"
"As linhas que começam com %s serão removidas.\n"

msgid ""
"If it does not apply cleanly, you will be given an opportunity to\n"
"edit again.  If all lines of the hunk are removed, then the edit is\n"
"aborted and the hunk is left unchanged.\n"
msgstr ""
"Se não for aplicado corretamente, você terá a oportunidade de\n"
"editar novamente. Se todas as linhas do pedaço forem removidas, a edição\n"
"será abortada e o pedaço permanecerá inalterado.\n"

msgid "could not parse hunk header"
msgstr "não foi possível analisar o cabeçalho do pedaço"

msgid "'git apply --cached' failed"
msgstr "'git apply --cached' falhou"

#. TRANSLATORS: do not translate [y/n]
#. The program will only accept that input at this point.
#. Consider translating (saying "no" discards!) as
#. (saying "n" for "no" discards!) if the translation
#. of the word "no" does not start with n.
#.
msgid ""
"Your edited hunk does not apply. Edit again (saying \"no\" discards!) [y/n]? "
msgstr ""
"Seu pedaço editado não se aplica. Editar novamente (dizer \"não\" descarta!) "
"[y/n]? "

msgid "The selected hunks do not apply to the index!"
msgstr "Os pedaços selecionados não se aplicam ao índice!"

msgid "Apply them to the worktree anyway? "
msgstr "Aplicá-los à árvore de trabalho mesmo assim? "

msgid "Nothing was applied.\n"
msgstr "Nada foi aplicado.\n"

#, c-format
msgid ""
"j - go to the next undecided hunk, roll over at the bottom\n"
"J - go to the next hunk, roll over at the bottom\n"
"k - go to the previous undecided hunk, roll over at the top\n"
"K - go to the previous hunk, roll over at the top\n"
