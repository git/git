#, c-format
msgid "Stage mode change%s [y,n,q,a,d%s,?]? "
msgstr "Preparar alteração de modo%s [y,n,q,a,d%s,?]? "

#, c-format
msgid "Stage deletion%s [y,n,q,a,d%s,?]? "
msgstr "Preparar exclusão%s [y,n,q,a,d%s,?]? "

#, c-format
msgid "Stage addition%s [y,n,q,a,d%s,?]? "
msgstr "Preparar adição%s [y,n,q,a,d%s,?]? "

#, c-format
msgid "Stage this hunk%s [y,n,q,a,d%s,?]? "
msgstr "Preparar este pedaço%s [y,n,q,a,d%s,?]? "

msgid ""
"If the patch applies cleanly, the edited hunk will immediately be marked for "
"staging."
msgstr ""
"Se o patch for aplicado corretamente, o pedaço editado será imediatamente "
"marcado para ser preparado."

msgid ""
"y - stage this hunk\n"
"n - do not stage this hunk\n"
"q - quit; do not stage this hunk or any of the remaining ones\n"
"a - stage this hunk and all later hunks in the file\n"
"d - do not stage this hunk or any of the later hunks in the file\n"
msgstr ""
"y - preparar este pedaço\n"
"n - não preparar este pedaço\n"
"q - sair; não preparar este pedaço nem nenhum dos restantes\n"
"a - preparar este pedaço e todos os pedaços posteriores no arquivo\n"
"d - não preparar este pedaço nem nenhum dos pedaços posteriores no arquivo\n"

#, c-format
msgid "Stash mode change%s [y,n,q,a,d%s,?]? "
msgstr "Fazer stash da alteração de modo%s [y,n,q,a,d%s,?]? "

